<Window x:Class="EBookLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека электронных книг" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0E8">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- верхняя панель с кнопками -->
        <Border Grid.Row="0" Background="#D2B48C" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddBookButton" Content="Добавить книгу" Height="35" Width="120"
                            Background="#8B7355" Foreground="White" BorderBrush="#6B5335"
                            Click="AddBookButton_Click" Margin="0,0,5,0" FontSize="14"/>
                    <Button x:Name="ImportCsvButton" Content="Импорт CSV" Height="35" Width="110"
                            Background="#A0855B" Foreground="White" BorderBrush="#8B7355"
                            Click="ImportCsvButton_Click" Margin="0,0,5,0" FontSize="14"/>
                    <Button x:Name="ExportCsvButton" Content="Экспорт CSV" Height="35" Width="110"
                            Background="#A0855B" Foreground="White" BorderBrush="#8B7355"
                            Click="ExportCsvButton_Click" Margin="0,0,5,0" FontSize="14"/>
                    <Button x:Name="BackupButton" Content="Резервная копия" Height="35" Width="130"
                            Background="#A0855B" Foreground="White" BorderBrush="#8B7355"
                            Click="BackupButton_Click" Margin="0,0,5,0" FontSize="14"/>
                    <Button x:Name="RestoreButton" Content="Восстановить" Height="35" Width="120"
                            Background="#A0855B" Foreground="White" BorderBrush="#8B7355"
                            Click="RestoreButton_Click" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="UserInfoText" VerticalAlignment="Center" 
                               Margin="0,0,10,0" Foreground="#5C4033" FontSize="14"/>
                    <Button x:Name="LogoutButton" Content="Выход" Height="35" Width="80"
                            Background="#C4A882" Foreground="#5C4033" BorderBrush="#8B7355"
                            Click="LogoutButton_Click" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- панель поиска и фильтров -->
        <Border Grid.Row="1" Background="#E8DCC8" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox" Height="30" 
                         Background="White" BorderBrush="#8B7355"
                         TextChanged="SearchTextBox_TextChanged"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Поиск" Height="30" Width="80"
                        Background="#8B7355" Foreground="White" BorderBrush="#6B5335"
                        Click="SearchButton_Click" Margin="5,0,5,0" FontSize="14"/>
                <Button Grid.Column="2" Content="Избранное" Height="30" Width="100"
                        Background="#D2B48C" Foreground="#5C4033" BorderBrush="#8B7355"
                        Click="FavoritesButton_Click" FontSize="14"/>
            </Grid>
        </Border>

        <!-- список книг -->
        <Border Grid.Row="2" Background="White" BorderBrush="#8B7355" 
                BorderThickness="1" CornerRadius="5">
            <DataGrid x:Name="BooksDataGrid" AutoGenerateColumns="False" 
                      IsReadOnly="True" Background="White"
                      RowBackground="White" AlternatingRowBackground="#F5F0E8"
                      SelectionMode="Single" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="150"/>
                    <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="120"/>
                    <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="70"/>
                    <DataGridTextColumn Header="Путь" Binding="{Binding FilePath}" Width="200"/>
                    <DataGridTemplateColumn Header="Избранное" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsFavorite, StringFormat={}{0}}" 
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding IsFavorite, Converter={StaticResource BoolToColorConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- кнопки действий с выбранной книгой -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,10,10">
            <Button x:Name="ReadBookButton" Content="Читать" Height="35" Width="100"
                    Background="#6B8E5A" Foreground="White" BorderBrush="#5A7D4A"
                    Click="ReadBookButton_Click" Margin="0,0,5,0" FontSize="14"/>
            <Button x:Name="EditBookButton" Content="Изменить" Height="35" Width="100"
                    Background="#D2B48C" Foreground="#5C4033" BorderBrush="#8B7355"
                    Click="EditBookButton_Click" Margin="0,0,5,0" FontSize="14"/>
            <Button x:Name="FavoriteBookButton" Content="В избранное" Height="35" Width="120"
                    Background="#D2B48C" Foreground="#5C4033" BorderBrush="#8B7355"
                    Click="FavoriteBookButton_Click" Margin="0,0,5,0" FontSize="14"/>
            <Button x:Name="DeleteBookButton" Content="Удалить" Height="35" Width="100"
                    Background="#B06050" Foreground="White" BorderBrush="#8B4030"
                    Click="DeleteBookButton_Click" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>