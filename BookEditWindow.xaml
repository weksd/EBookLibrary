<Window x:Class="EBookLibrary.Views.BookEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование книги" Height="400" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0E8">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Добавление книги" 
                       FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       Foreground="#5C4033"/>

            <TextBlock Text="Название:" Margin="0,0,0,5" Foreground="#5C4033"/>
            <TextBox x:Name="TitleTextBox" Height="30" Margin="0,0,0,10"
                     Background="White" BorderBrush="#8B7355"/>

            <TextBlock Text="Автор:" Margin="0,0,0,5" Foreground="#5C4033"/>
            <TextBox x:Name="AuthorTextBox" Height="30" Margin="0,0,0,10"
                     Background="White" BorderBrush="#8B7355"/>

            <TextBlock Text="Жанр:" Margin="0,0,0,5" Foreground="#5C4033"/>
            <TextBox x:Name="GenreTextBox" Height="30" Margin="0,0,0,10"
                     Background="White" BorderBrush="#8B7355"/>

            <TextBlock Text="Год:" Margin="0,0,0,5" Foreground="#5C4033"/>
            <TextBox x:Name="YearTextBox" Height="30" Margin="0,0,0,10"
                     Background="White" BorderBrush="#8B7355"/>

            <TextBlock Text="Путь к файлу:" Margin="0,0,0,5" Foreground="#5C4033"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathTextBox" Height="30"
                         Background="White" BorderBrush="#8B7355"
                         IsReadOnly="True"/>
                <Button Grid.Column="1" Content="Обзор" Height="30" Width="60"
                        Background="#D2B48C" Foreground="#5C4033"
                        BorderBrush="#8B7355" Click="BrowseButton_Click"
                        Margin="5,0,0,0"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveButton" Content="Сохранить" Height="35"
                        Background="#8B7355" Foreground="White"
                        BorderBrush="#6B5335" Click="SaveButton_Click"
                        FontSize="14" Margin="0,0,5,0"/>
                <Button Grid.Column="1" Content="Отмена" Height="35"
                        Background="#D2B48C" Foreground="#5C4033"
                        BorderBrush="#8B7355" Click="CancelButton_Click"
                        FontSize="14" Margin="5,0,0,0"/>
            </Grid>

            <TextBlock x:Name="ErrorMessage" Foreground="Red" 
                       HorizontalAlignment="Center" Margin="0,10,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
