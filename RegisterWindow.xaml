<Window x:Class="EBookLibrary.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0E8">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Регистрация нового пользователя" 
                       FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       Foreground="#5C4033"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5" Foreground="#5C4033"/>
            <TextBox x:Name="LoginTextBox" Height="30" Margin="0,0,0,10"
                     Background="White" BorderBrush="#8B7355"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5" Foreground="#5C4033"/>
            <PasswordBox x:Name="PasswordBox" Height="30" Margin="0,0,0,10"
                         Background="White" BorderBrush="#8B7355"/>

            <TextBlock Text="Подтвердите пароль:" Margin="0,0,0,5" Foreground="#5C4033"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="30" Margin="0,0,0,20"
                         Background="White" BorderBrush="#8B7355"/>

            <Button x:Name="RegisterButton" Content="Зарегистрироваться" Height="35"
                    Background="#8B7355" Foreground="White"
                    BorderBrush="#6B5335" Click="RegisterButton_Click"
                    FontSize="14"/>

            <TextBlock x:Name="ErrorMessage" Foreground="Red" 
                       HorizontalAlignment="Center" Margin="0,10,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>